---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import playBadge from '../assets/play.png';
import fdroidBadge from '../assets/fdroid.png';
import appStoreBadge from '../assets/appstore.svg';
import hero from '../assets/hero.png';
import shotSearch from '../assets/shot-search.png';
import shotInfo from '../assets/shot-info.png';
import shotTime from '../assets/shot-time.png';
import shotNight from '../assets/shot-night.png';
import { useT } from '../i18n';
import quotes from '../data/quotes.json';
import links from '../data/links.json';
import stats from '../data/stats.json';

const t = useT('en');
const shown = [
  stats.rating.verified && { k: `${stats.rating.value}★`, v: 'lifetime on Google Play' },
  stats.v2Rating.verified && { k: `${stats.v2Rating.value}★`, v: 'on version 2' },
  stats.downloads.verified && { k: String(stats.downloads.value), v: 'downloads' },
  stats.githubStars.verified && { k: stats.githubStars.value.toLocaleString('en'), v: 'GitHub stars' },
].filter(Boolean) as { k: string; v: string }[];
const features = [
  { id: 'search', img: shotSearch, alt: 'Search the sky with a direction arrow' },
  { id: 'info', img: shotInfo, alt: 'An object info card for the Orion Nebula' },
  { id: 'time', img: shotTime, alt: 'Time travel controls' },
  { id: 'night', img: shotNight, alt: 'Sky Map in red night mode' },
] as const;
const v2 = [1, 2, 3, 4, 5, 6] as const;
---
<Base>
  <section class="wrap hero">
    <div class="copy">
      <p class="eyebrow">{t('hero.eyebrow')}</p>
      <h1>{t('hero.title.a')} <span>{t('hero.title.b')}</span></h1>
      <p class="lede muted">{t('hero.lede')}</p>
      {shown.length > 0 && (
        <dl class="stats">
          {shown.map((s) => <div><dt>{s.k}</dt><dd>{s.v}</dd></div>)}
        </dl>
      )}
      <p class="ctas badges">
        <a href={links.play} aria-label={t('cta.play')}><Image src={playBadge} alt="" height={64} /></a>
        <a href={links.fdroid} aria-label={t('cta.fdroid')}><Image src={fdroidBadge} alt="" height={64} /></a>
        <span class="soon" role="img" aria-label={t('cta.appstore')}><img src={appStoreBadge.src} alt="" height="43" /><small>Coming soon</small></span>
      </p>
    </div>
    <Image class="shot" src={hero} alt="Sky Map showing constellations and planets overhead at night" widths={[360, 540, 720]} sizes="(min-width: 900px) 360px, 70vw" loading="eager" />
  </section>

  <section class="wrap features" aria-labelledby="feat">
    <h2 id="feat">{t('feat.title')}</h2>
    <div class="grid">
      {features.map((f) => (
        <figure>
          <Image src={f.img} alt={f.alt} widths={[240, 360, 480]} sizes="(min-width: 900px) 22vw, 45vw" />
          <figcaption>
            <h3>{t(`feat.${f.id}.t` as any)}</h3>
            <p class="muted">{t(`feat.${f.id}.d` as any)}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="band" aria-labelledby="v2">
    <div class="wrap">
      <p class="eyebrow">{t('v2.eyebrow')}</p>
      <h2 id="v2">{t('v2.title')}</h2>
      <p class="muted lede2">{t('v2.lede')}</p>
      <ul class="cards">
        {v2.map((n) => (
          <li><h3>{t(`v2.${n}.t` as any)}</h3><p class="muted">{t(`v2.${n}.d` as any)}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap quotes" aria-label="What people say">
    <ul class="qlist" id="qlist">
      {quotes.map((q) => (
        <li><blockquote><p>“{q.text}”</p><footer class="muted">★★★★★ Google Play review · v{q.version}</footer></blockquote></li>
      ))}
    </ul>
  </section>

  <section class="wrap story">
    <h2>{t('story.title')}</h2>
    <p class="prose">{t('story.d')}</p>
    <p class="ctas">
      <a class="btn" href="/history">{t('story.history')}</a>
      <a class="btn" href={links.support}>{t('footer.support')}</a>
    </p>
  </section>
  <script is:inline>
    (function () {
      var l = document.getElementById('qlist');
      if (!l || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var paused = false, i = 0;
      ['mouseenter', 'focusin', 'touchstart'].forEach(function (e) { l.addEventListener(e, function () { paused = true; }); });
      setInterval(function () {
        if (paused) return;
        i = (i + 1) % l.children.length;
        l.scrollTo({ left: l.children[i].offsetLeft - l.children[0].offsetLeft, behavior: 'smooth' });
      }, 6000);
    })();
  </script>
</Base>

<style>
  .hero { display: grid; gap: 3rem; align-items: center; padding-block: 4rem; }
  @media (min-width: 900px) { .hero { grid-template-columns: 1.2fr 1fr; } }
  h1 span { display: block; color: var(--star-gold); }
  .lede { max-width: var(--measure); font-size: 1.2rem; }
  .stats { display: flex; gap: 2rem; margin: 2rem 0; }
  .stats dt { font: 500 1.5rem var(--data); }
  .stats dd { margin: 0; color: var(--muted); font-size: .9rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: .75rem; }
  .shot { width: 100%; max-width: 360px; height: auto; justify-self: center; border-radius: 28px; border: 1px solid var(--outline-variant); }
  .features { padding-block: 3rem; }
  .grid { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  figure { margin: 0; }
  figure img { width: 100%; height: auto; border-radius: 20px; border: 1px solid var(--outline-variant); }
  figcaption h3 { margin: 1rem 0 .25rem; font-size: 1.15rem; }
  figcaption p { margin: 0; font-size: .95rem; }
  .band { background: var(--surface); border-block: 1px solid var(--outline-variant); padding-block: 4rem; margin-block: 3rem; }
  .lede2 { max-width: var(--measure); }
  .cards { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
  .cards li { background: var(--surface-container); border: 1px solid var(--outline-variant); border-radius: 12px; padding: 1.25rem; }
  .cards h3 { font-size: 1.1rem; margin-bottom: .4rem; }
  .cards p { margin: 0; font-size: .95rem; }
  .quotes { padding-block: 1rem; }
  .qlist { list-style: none; margin: 0; padding: 0; display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: thin; }
  .qlist li { flex: 0 0 min(100%, 640px); scroll-snap-align: start; }
  blockquote { margin: 0; height: 100%; background: var(--surface-container); border: 1px solid var(--outline-variant); border-radius: 12px; padding: 1.5rem; }
  blockquote p { margin: 0 0 1rem; font-size: 1.15rem; }
  blockquote footer { font: 500 .8rem var(--data); }
  .story { padding-block: 2rem; }
  .badges { align-items: center; gap: .25rem .5rem; }
  .badges a, .badges img { display: block; }
  .soon { position: relative; display: block; margin-left: .5rem; }
  .soon img { opacity: .5; filter: grayscale(1); }
  .soon small { position: absolute; top: 100%; left: 0; right: 0; text-align: center; white-space: nowrap; font: 500 .7rem var(--data); color: var(--muted); }
</style>
