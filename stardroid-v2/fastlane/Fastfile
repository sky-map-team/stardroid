default_platform(:android)

platform :android do
  # v2 uses the Kotlin DSL build script, not the legacy Groovy `app/build.gradle`.
  # Verified: fastlane-plugin-versioning_android (0.1.1) reads/writes the Kotlin DSL
  # `versionCode = 1` / `versionName = "..."` syntax correctly (it splits on whitespace
  # and takes the last token), leaving applicationId/namespace untouched. Confirmed
  # end-to-end via `bundle exec fastlane` against app/build.gradle.kts.
  GRADLE_FILE = "app/build.gradle.kts"

  # v2 is minSdk 28 (Android 9 is best-effort only — D9 — but still installable), while the
  # Play listing is shared with v1 (minSdk 26), so a v2 upload must keep the older v1 bundles
  # active or pre-28 devices that cannot install v2 are left with nothing. Play serves each
  # device the highest version code it is eligible for, so these are what pre-28 devices
  # receive:
  #   1708 — v1 1.18.1:Eclipse, the last v1 release and the permanent build for API 26–27
  #   1115, 1202 — v1's own long-standing retention set for still older devices
  # Omitting these deactivates them; a v2 release must list every code it wants to survive.
  V1_VERSION_CODES_TO_RETAIN = [1115, 1202, 1708]

  desc "Run unit tests, ktlint, and the Konsist architecture gate via `check`"
  lane :test do
    gradle(task: "check")
  end

  desc "Increment version code"
  lane :increment_version_code do
    android_set_version_code(gradle_file: GRADLE_FILE)
  end

  desc "Sync local version code to the Play Console before incrementing, in case another " \
       "upload (a different checkout, a manual upload) advanced it past our gradle file"
  lane :sync_version_code_from_play_store do
    tracks = ['internal', 'alpha', 'beta', 'production']
    used_codes = tracks.flat_map do |track|
      google_play_track_version_codes(
        track: track,
        package_name: "com.google.android.stardroid",
        json_key: "fastlane/play-store-credentials.json"
      )
    end
    highest_remote = used_codes.max || 0
    local_code = android_get_version_code(gradle_file: GRADLE_FILE).to_i
    if highest_remote > local_code
      UI.important("Play Console has versionCode #{highest_remote} in use, ahead of the " \
                    "local #{local_code} — syncing before increment.")
      android_set_version_code(gradle_file: GRADLE_FILE, version_code: highest_remote)
    end
  end

  desc "Set a specific version name (e.g., fastlane bump_version name:\"1.5.0:Mars\") The name must have no spaces."
  lane :bump_version do |options|
    options ||= {}
    version_name = options[:name]
    UI.user_error!("Provide a version name using name:\"value\" (no spaces)") unless version_name
    android_set_version_name(
      version_name: version_name,
      gradle_file: GRADLE_FILE
    )
  end

  desc "Build release bundle"
  lane :build do
    UI.message("***Make sure you have regenerated the data if necessary***")
    gradle(
      task: ":app:bundleGmsRelease",
      project_dir: "./"
    )
  end

  desc "Deploy to internal testing track"
  lane :internal do
    sync_version_code_from_play_store
    increment_version_code
    build
    v_code = android_get_version_code(gradle_file: GRADLE_FILE)
    v_name = android_get_version_name(gradle_file: GRADLE_FILE)

    upload_to_play_store(
      track: "internal",
      version_codes_to_retain: V1_VERSION_CODES_TO_RETAIN,
      aab: "app/build/outputs/bundle/gmsRelease/app-gms-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      changes_not_sent_for_review: true,
      version_name: "#{v_name} (#{v_code})",
      version_code: v_code
    )
  end

  desc "Promote Internal to Alpha (Closed Testing)"
    lane :promote_to_alpha do
      upload_to_play_store(
        track: 'internal',
        track_promote_to: 'alpha',
        version_codes_to_retain: V1_VERSION_CODES_TO_RETAIN,
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true,
        skip_upload_changelogs: true
      )
  end

  desc "Promote Alpha to Beta (Open Testing @10%)"
  lane :promote_to_beta do
    upload_to_play_store(
      track: 'alpha',
      track_promote_to: 'beta',
      version_codes_to_retain: V1_VERSION_CODES_TO_RETAIN,
      rollout: '0.1', # Start with a 10% rollout
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  desc "Promote Beta to Production @10%"
  lane :promote_to_production do
    # This lane assumes you've already tested the build in Beta
    upload_to_play_store(
      track: 'beta',
      track_promote_to: 'production',
      version_codes_to_retain: V1_VERSION_CODES_TO_RETAIN,
      rollout: '0.1', # Start with a 10% rollout
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true
    )
  end

  # Typically these lanes aren't needed - we upload to internal and promote from there
  # rather than uploading directly to the other tracks.

  desc "Deploy to alpha track"
  lane :alpha do
    sync_version_code_from_play_store
    increment_version_code
    build
    upload_to_play_store(
      track: "alpha",
      aab: "app/build/outputs/bundle/gmsRelease/app-gms-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy to beta track - shouldn't you deploy to internal first?"
  lane :beta_yes_im_sure do
    sync_version_code_from_play_store
    increment_version_code
    build
    upload_to_play_store(
      track: "beta",
      aab: "app/build/outputs/bundle/gmsRelease/app-gms-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Deploy to production - shouldn't you deploy to internal first?"
  lane :production_yes_im_sure do
    sync_version_code_from_play_store
    increment_version_code
    build
    upload_to_play_store(
      track: "production",
      aab: "app/build/outputs/bundle/gmsRelease/app-gms-release.aab",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end

  desc "Capture screenshots for Play Store. Specify --device_type=sevenInch for a tablet."
  lane :screenshots do
    gradle(
      task: ":app:assembleGmsDebug",
      project_dir: "./"
    )
    gradle(
      task: ":app:assembleGmsDebugAndroidTest",
      project_dir: "./"
    )
    screengrab
  end

  desc "Upload metadata. Options (defaults after the colon): whatsnew:true (include changelogs), imgs:true (include screenshots/images), all:false (everything), store:false (skip store metadata)."
  lane :upload_metadata do |options|
    options ||= {}
    # Changelog uploads require a version code; fall back to the current Gradle value
    # when the caller doesn't pass one explicitly.
    v_code = options[:version_code] || android_get_version_code(gradle_file: GRADLE_FILE)
    include_all = options.fetch(:all, false)
    include_whatsnew = include_all || options.fetch(:whatsnew, true)
    include_imgs = include_all || options.fetch(:imgs, true)
    include_store = include_all || options.fetch(:store, false)
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_metadata: !include_store,
      skip_upload_changelogs: !include_whatsnew,
      skip_upload_images: !include_imgs,
      skip_upload_screenshots: !include_imgs,
      changes_not_sent_for_review: false,
      version_code: v_code,
      track: 'internal'
    )
  end
end

platform :ios do
  IOS_DIR = File.expand_path("../ios/SkyMap", __dir__)
  IOS_PROJECT = File.join(IOS_DIR, "SkyMap.xcodeproj")
  IOS_BUNDLE_ID = "io.penterakt.skymap"

  # Key and issuer IDs identify the App Store Connect API key (App Manager role); they are not
  # secret. The .p8 itself is, so it lives outside the repo: override its path with
  # APP_STORE_CONNECT_KEY_PATH.
  ASC_KEY_ID = "8XZ54P8LKA"
  ASC_ISSUER_ID = "5d668d96-b7d1-41e4-aacc-8fb07cc2aba3"
  ASC_KEY_PATH = ENV["APP_STORE_CONNECT_KEY_PATH"] ||
    File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ASC_KEY_ID}.p8")

  private_lane :asc_api_key do
    @asc_api_key ||= begin
      UI.user_error!("App Store Connect key not found at #{ASC_KEY_PATH}") unless File.exist?(ASC_KEY_PATH)
      app_store_connect_api_key(
        key_id: ASC_KEY_ID,
        issuer_id: ASC_ISSUER_ID,
        key_filepath: ASC_KEY_PATH,
        in_house: false
      )
    end
  end

  # The .xcodeproj is generated from project.yml and is not checked in.
  def generate_project
    sh("cd #{IOS_DIR} && xcodegen")
  end

  desc "Archive the Release build and export a signed App Store .ipa (build number: latest TestFlight build + 1)"
  lane :build do
    api_key = asc_api_key
    generate_project
    version = File.read(File.join(IOS_DIR, "project.yml"))[/MARKETING_VERSION:\s*"([^"]+)"/, 1]
    UI.user_error!("MARKETING_VERSION not found in project.yml") unless version
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: IOS_BUNDLE_ID,
      version: version,
      initial_build_number: 0
    ) + 1
    UI.message("Building #{version} (#{build_number})")
    build_app(
      project: IOS_PROJECT,
      scheme: "SkyMap",
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(IOS_DIR, "build", "ipa"),
      output_name: "SkyMap.ipa",
      # No API-key flags here: exporting for the App Store needs cloud-signed distribution
      # certificates, which an App Manager key cannot create. Xcode must be signed in to the
      # Penterakt team (Settings > Accounts); the key is used only for TestFlight.
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number} -allowProvisioningUpdates"
    )
  end

  desc "Install the Release build on a connected iPhone, development-signed, without uploading " \
       "(device:<CoreDevice id> or IOS_DEVICE_ID). Needs the device registered on the team."
  lane :device do |options|
    options ||= {}
    generate_project
    build_app(
      project: IOS_PROJECT,
      scheme: "SkyMap",
      configuration: "Release",
      export_method: "development",
      output_directory: File.join(IOS_DIR, "build", "ipa-dev"),
      output_name: "SkyMap.ipa",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{ASC_KEY_PATH} -authenticationKeyID #{ASC_KEY_ID} " \
              "-authenticationKeyIssuerID #{ASC_ISSUER_ID}"
    )
    device = options[:device] || ENV["IOS_DEVICE_ID"]
    UI.user_error!("Pass device:<CoreDevice id> (see `xcrun devicectl list devices`)") unless device
    sh("xcrun", "devicectl", "device", "install", "app", "--device", device,
       File.join(IOS_DIR, "build", "ipa-dev", "SkyMap.ipa"))
  end

  # deliver only looks for an editable version, so this needs one in App Store Connect first, even
  # for promotional text; use the promo lane to change that on the live version.
  desc "Upload App Store listing text from fastlane/metadata/ios to the editable version (no " \
       "binary, no screenshots, no submission)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: IOS_BUNDLE_ID,
      metadata_path: File.expand_path("metadata/ios", __dir__),
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      version_check_wait_retry_limit: 1
    )
  end

  # Promotional text is the one field Apple lets you change on a live version without review.
  # Calls Spaceship directly because deliver's edit_live crashes in 2.240.1 (it skips loading the
  # version localizations, then enqueues nil in upload_metadata.rb).
  desc "Update only the promotional text on the live App Store version"
  lane :promo do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(IOS_BUNDLE_ID)
    UI.user_error!("App #{IOS_BUNDLE_ID} not found") unless app
    version = app.get_live_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)
    UI.user_error!("No live iOS version found") unless version
    text = File.read(File.join(__dir__, "metadata/ios/en-US/promotional_text.txt")).strip
    localization = version.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
    UI.user_error!("No en-US localization on live version #{version.version_string}") unless localization
    UI.message("Setting en-US promotional text on live version #{version.version_string}")
    localization.update(attributes: { promotionalText: text })
  end

  desc "Build and upload to TestFlight (internal testers). Pass changelog:\"...\" for What to Test."
  lane :beta do |options|
    options ||= {}
    build
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: IOS_BUNDLE_ID,
      changelog: options[:changelog],
      skip_waiting_for_build_processing: true
    )
  end
end
