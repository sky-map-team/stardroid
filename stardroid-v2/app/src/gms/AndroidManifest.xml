<?xml version="1.0" encoding="utf-8"?>
<!--
  Sky Map does not advertise, so the advertising-identifier permissions that
  firebase-analytics injects have no purpose here. Stripping them keeps the gms build's
  permission set identical to fdroid's, which is what the terms screen and the Play
  listing tell users (see values/eula.xml, permissions_notice). Analytics itself is
  unaffected: events and user properties are keyed on the Firebase app-instance ID.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />
    <uses-permission
        android:name="com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
        tools:node="remove" />
</manifest>
