<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Dev harness and D19 perf-gate host (audit-2026-08 H1). Debug-only: it opens the
          catalog database, registers sensor listeners and requests location, so it must never
