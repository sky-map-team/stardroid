<?xml version="1.0" encoding="utf-8"?>
<!-- The moon-phase widget (D69): 2×2 cells by default, freely resizable down to 2×2.
     updatePeriodMillis stays 0 — refresh belongs to MoonWidgetScheduler's WorkManager job,
     not AppWidgetManager alarms. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/moon_widget_description"
    android:initialLayout="@layout/moon_widget_initial"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:previewLayout="@layout/moon_widget_initial"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
