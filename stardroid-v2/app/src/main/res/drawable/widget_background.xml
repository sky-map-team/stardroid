<?xml version="1.0" encoding="utf-8"?>
<!-- The widget surface (D67/D69): brand navy at 86% opacity over the wallpaper, 22 dp
     corners, a hairline outlineVariant border. A drawable (not GlanceModifier.cornerRadius)
     so corners round on every API level, minSdk 29 included. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#DB0E1428" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="#2A3355" />
</shape>
