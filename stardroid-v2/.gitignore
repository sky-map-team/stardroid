# Gradle / build
.gradle/
.kotlin/
build/
**/build/
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Fastlane
fastlane/report.xml

# Secrets / signing (never commit)
*.keystore
*.jks
*.pem
*credentials*
*google-services.json*
*no-checkin*
no-checkin.properties
.env

# Fetched sources for the planet-disc generator (see tools/planets/README.md)
tools/planets/.cache/

# iOS: Xcode projects are generated by XcodeGen from project.yml (see ios/README.md)
ios/**/*.xcodeproj/
# ...and their Xcode build output (-derivedDataPath build, build-sim, build-device, ...)
ios/**/build*/
# ...and test result bundles (-resultBundlePath), which belong in a scratch directory
*.xcresult/
